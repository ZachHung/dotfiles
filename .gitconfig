[init]  
	defaultBranch = main
[user]
	email = zachhung911@gmail.com
	name = ZachHung
[alias]
	hist = log --pretty=format:'%C(yellow)[%ad]%C(reset) %C(green)[%h]%C(reset) | %C(white)%s %C(bold cyan){{%an}}%C(reset) %C(blue)%d%C(reset)' --graph --date=short
	co = checkout
	cob = checkout -b
	coo = !git fetch && git checkout
	sw = switch 
	swc = switch -c
	br = branch
	brd = branch -d
	st = status
	aa = add -A .
	unstage = reset --soft HEAD^
	cm = commit -m
	amend = commit --amend -m
	fix = commit --fixup
	undo = reset HEAD~1
	rv = revert
	cp = cherry-pick
	pu = !git push origin `git branch --show-current`
	fush = push --force-with-lease
	mg = merge --no-ff
	rb = rebase
	rbc = rebase --continue
	rba = rebase --abort
	rbs = rebase --skip
	rom = !git fetch && git rebase -i origin/main --autosquash
	save = stash push
	pop = stash pop
	apply = stash apply
	rl = reflog
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
    line-numbers = true
	navigate = true
	dark = true
	syntax-theme = Nord
	minus-style = "syntax \"#472F32\""
	minus-emph-style = "syntax \"#5F393D\""
	plus-style = "syntax \"#40473A\""
	plus-emph-style = "syntax \"#545F4B\""
	line-numbers-minus-style = "\"#BF616A\""
	line-numbers-plus-style = "\"#A3BE8C\""
	line-numbers-zero-style = "\"#4C566A\""
[merge]
	conflictStyle = zdiff3
[credential "https://github.com"]
	helper = 
	helper = !/home/zachhung/.local/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/home/zachhung/.local/bin/gh auth git-credential
